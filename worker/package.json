{
  "name": "fato-portal-api-teste",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute fato-portal-db-teste --file=./d1/schema.sql --remote",
    "db:data": "wrangler d1 execute fato-portal-db-teste --file=./d1/data.sql --remote",
    "db:schema:local": "wrangler d1 execute fato-portal-db-teste --file=./d1/schema.sql --local",
    "db:data:local": "wrangler d1 execute fato-portal-db-teste --file=./d1/data.sql --local"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
